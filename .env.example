# Firebase Client Configuration (Optional - overrides firebase-applet-config.json)
# If deploying to Vercel or custom domain with your own Firebase project (e.g. one-cloud-6df65):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=one-cloud-6df65.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=one-cloud-6df65
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=one-cloud-6df65.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=

# Server session encryption secret (AES-256)
SESSION_SECRET=one-cloud-secret-key-32-chars-long-aes-256!

# Optional Default Telegram App credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=